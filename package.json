{
  "name": "simulador-estagio-sgest",
  "private": true,
  "type": "module",
  "workspaces": [
    "calc",
    "web"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test:db": "vitest run --config vitest.db.config.ts",
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "preview": "npm run preview -w web",
    "snapshot": "node scripts/snapshot.ts",
    "verificar:producao": "node scripts/verificar-producao.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1"
  }
}
